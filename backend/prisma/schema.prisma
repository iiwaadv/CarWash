// نظام إدارة مغاسل إيجاز (Ejaz Car Wash Ops) - Database Schema
// Note: provider is "sqlite" for zero-setup local development.
// Prisma enums are not supported on SQLite, so enum-like columns are
// modelled as String and validated at the application layer (see
// src/validators). Swapping datasource provider to "postgresql" and
// converting the relevant String fields to native `enum` blocks is a
// safe, isolated change for production deployments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. الفروع
// ---------------------------------------------------------------------------
model Branch {
  id            Int      @id @default(autoincrement()) @map("branch_id")
  name          String
  status        String   @default("closed") // open | closed | maintenance
  isActive      Boolean  @default(true) @map("is_active") // soft-delete: false = محذوف/مؤرشف
  shiftOpenTime  String  @default("06:00") @map("shift_open_time") // "HH:MM" - يحدده المدير
  shiftCloseTime String  @default("23:00") @map("shift_close_time") // "HH:MM" - يحدده المدير
  createdAt     DateTime @default(now()) @map("created_at")

  bays               Bay[]
  employees          Employee[]
  jobOrders          JobOrder[]
  shiftInventoryReports ShiftInventoryReport[]
  shiftOpenings         ShiftOpening[]
  maintenanceIncidents  MaintenanceIncident[]
  cleanlinessChecks     CleanlinessCheck[]
  maintenanceSchedules  MaintenanceSchedule[]
  tasks                 Task[]
  salesTargets          SalesTarget[]
  inventoryBalances     BranchInventoryBalance[]
  inventoryMovements    InventoryMovement[]

  @@map("branches")
}

// ---------------------------------------------------------------------------
// 2. المواقف (Bays)
// ---------------------------------------------------------------------------
model Bay {
  id       Int    @id @default(autoincrement()) @map("bay_id")
  branchId Int    @map("branch_id")
  bayName  String @map("bay_name")
  bayType  String? @map("bay_type") // normal | vip ...

  branch           Branch               @relation(fields: [branchId], references: [id])
  assignments      BayCrewAssignment[]
  jobOrders        JobOrder[]
  equipment        BayEquipment[]
  incidents        MaintenanceIncident[]
  defaultEmployees Employee[]           @relation("EmployeeDefaultBay")

  @@map("bays")
}

// أجهزة/معدات كل موقف غسيل - يديرها المدير لربط بلاغات الأعطال بجهاز محدد
model BayEquipment {
  id            Int       @id @default(autoincrement()) @map("equipment_id")
  bayId         Int       @map("bay_id")
  name          String    @map("equipment_name")
  serialNumber  String?   @map("serial_number")
  installedAt   DateTime? @map("installed_at")
  warrantyUntil DateTime? @map("warranty_until")
  notes         String?
  photosJson    String?   @map("photos_json")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  bay       Bay                   @relation(fields: [bayId], references: [id])
  incidents MaintenanceIncident[]

  @@map("bay_equipment")
}

// ---------------------------------------------------------------------------
// 3. الموظفون
// ---------------------------------------------------------------------------
model Employee {
  id                    Int     @id @default(autoincrement()) @map("employee_id")
  branchId              Int     @map("branch_id")
  name                  String
  role                  String // manager | branch_manager | supervisor | washer | detailer
  jobTitle              String? @map("job_title") // مسمى وظيفي ديناميكي للعرض
  managedBranchIdsJson  String? @map("managed_branch_ids_json") // لفروع مدير الفروع
  permissionsJson       String? @map("permissions_json") // صلاحيات اختيارية JSON
  pinCode               String  @map("pin_code") // hashed 4-digit PIN
  isActive              Boolean @default(true) @map("is_active")
  defaultBayId          Int?    @map("default_bay_id") // ربط العامل بموقف غسيل افتراضي

  branch                Branch                 @relation(fields: [branchId], references: [id])
  defaultBay            Bay?                   @relation("EmployeeDefaultBay", fields: [defaultBayId], references: [id])
  bayAssignments        BayCrewAssignment[]
  inspectedQualityLogs  QualityLog[]           @relation("Inspector")
  shiftInventoryReports ShiftInventoryReport[]
  shiftOpenings         ShiftOpening[]
  upsellingLogs         UpsellingLog[]
  assignedTasks         Task[]                 @relation("TaskAssignee")
  createdTasks          Task[]                 @relation("TaskCreator")
  receivedIncidents     MaintenanceIncident[]  @relation("IncidentReceiver")
  decidedIncidents      MaintenanceIncident[]  @relation("IncidentDecider")
  auditLogs             AuditLog[]

  @@map("employees")
}

// ---------------------------------------------------------------------------
// 4. ربط عمال المواقف بالورديات
// ---------------------------------------------------------------------------
model BayCrewAssignment {
  id         Int      @id @default(autoincrement()) @map("assignment_id")
  bayId      Int      @map("bay_id")
  employeeId Int      @map("employee_id")
  shiftDate  DateTime @map("shift_date")

  bay      Bay      @relation(fields: [bayId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("bay_crew_assignments")
}

// ---------------------------------------------------------------------------
// 5. الخدمات وقواعد البيع الإضافي
// ---------------------------------------------------------------------------
model Service {
  id                   Int     @id @default(autoincrement()) @map("service_id")
  serviceName          String  @map("service_name")
  basePrice            Float   @map("base_price")
  suggestedTrigger     String? @map("suggested_trigger") // e.g. car_type=large
  quantity             Int     @default(1) // عدد مرات/وحدات الخدمة المعروضة
  linkedProductIdsJson String? @map("linked_product_ids_json") // JSON number[] من InventoryItem
  targetBranchIdsJson  String? @map("target_branch_ids_json") // JSON number[] من Branch

  upsellingLogs UpsellingLog[]
  salesTargets  SalesTarget[]

  @@map("services")
}

// ---------------------------------------------------------------------------
// 6. تذاكر غسيل السيارات
// ---------------------------------------------------------------------------
model JobOrder {
  id                Int      @id @default(autoincrement()) @map("job_id")
  branchId          Int      @map("branch_id")
  bayId             Int?     @map("bay_id")
  posInvoiceNo      String?  @map("pos_invoice_no")
  plateNumber       String   @map("plate_number")
  customerPhone     String?  @map("customer_phone")
  carType           String?  @map("car_type") // small | medium | large
  status            String   @default("queued") // queued|washing|quality_check|ready|delivered
  isHighlyDirty     Boolean  @default(false) @map("is_highly_dirty")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  washingStartedAt  DateTime? @map("washing_started_at")
  readyAt           DateTime? @map("ready_at")
  deliveredAt       DateTime? @map("delivered_at")
  clientUuid        String?  @map("client_uuid") // idempotency key from offline tablet sync

  branch           Branch             @relation(fields: [branchId], references: [id])
  bay              Bay?               @relation(fields: [bayId], references: [id])
  qualityLogs      QualityLog[]
  upsellingLogs    UpsellingLog[]
  customerFeedback CustomerFeedback[]

  @@map("job_orders")
  @@index([branchId, status])
}

// ---------------------------------------------------------------------------
// 7. فحص الجودة
// ---------------------------------------------------------------------------
model QualityLog {
  id                Int      @id @default(autoincrement()) @map("quality_id")
  jobId             Int      @map("job_id")
  stage             String   // pre_wash_photos | post_wash_checklist
  scratchesNotes    String?  @map("scratches_notes")
  photosJson        String?  @map("photos_json") // JSON array of {url, takenAt, watermark}
  checklistResults  String?  @map("checklist_results") // JSON {exterior,interior,tires,finishing}
  touchUpNeeded     Boolean  @default(false) @map("touch_up_needed")
  touchUpAt         DateTime? @map("touch_up_at")
  inspectorId       Int?     @map("inspector_id")
  createdAt         DateTime @default(now()) @map("created_at")

  job       JobOrder  @relation(fields: [jobId], references: [id])
  inspector Employee? @relation("Inspector", fields: [inspectorId], references: [id])

  @@map("quality_logs")
}

// ---------------------------------------------------------------------------
// 8. سجلات التسويق والبيع الإضافي
// ---------------------------------------------------------------------------
model UpsellingLog {
  id               Int      @id @default(autoincrement()) @map("upsell_id")
  jobId            Int      @map("job_id")
  serviceId        Int      @map("service_id")
  employeeId       Int?     @map("employee_id") // من قام بعرض/تسجيل العملية على التابلت (المستحق للبونص)
  status           String   // accepted | rejected
  rejectionReason  String?  @map("rejection_reason") // too_expensive|in_a_hurry|old_car|loyalty_program
  extraInvoiceNo   String?  @map("extra_invoice_no")
  bonusAmount      Float    @default(0) @map("bonus_amount")
  createdAt        DateTime @default(now()) @map("created_at")

  job      JobOrder  @relation(fields: [jobId], references: [id])
  service  Service   @relation(fields: [serviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@map("upselling_logs")
}

// ---------------------------------------------------------------------------
// 9. التقييمات الصوتية ورضا العملاء
// ---------------------------------------------------------------------------
model CustomerFeedback {
  id                 Int      @id @default(autoincrement()) @map("feedback_id")
  jobId              Int      @map("job_id")
  voiceRecUrl        String?  @map("voice_rec_url")
  isCustomerFurious  Boolean  @default(false) @map("is_customer_furious")
  alertAcknowledged  Boolean  @default(false) @map("alert_acknowledged")
  createdAt          DateTime @default(now()) @map("created_at")

  job JobOrder @relation(fields: [jobId], references: [id])

  @@map("customer_feedback")
}

// ---------------------------------------------------------------------------
// جرد بداية الوردية (فتح الوردية) - Phase 4
// ---------------------------------------------------------------------------
model ShiftOpening {
  id             Int      @id @default(autoincrement()) @map("opening_id")
  branchId       Int      @map("branch_id")
  supervisorId   Int      @map("supervisor_id")
  shiftDate      DateTime @map("shift_date")
  towelsReceived Int      @map("towels_received")
  chemicalsJson  String?  @map("chemicals_json") // JSON {product: liters}
  otherItemsJson String?  @map("other_items_json") // JSON [{name, qty}]
  createdAt      DateTime @default(now()) @map("created_at")

  branch     Branch   @relation(fields: [branchId], references: [id])
  supervisor Employee @relation(fields: [supervisorId], references: [id])

  @@map("shift_openings")
  @@index([branchId, shiftDate])
}

// ---------------------------------------------------------------------------
// 10. جرد المخزون والمناشف (إغلاق الوردية)
// ---------------------------------------------------------------------------
model ShiftInventoryReport {
  id                     Int      @id @default(autoincrement()) @map("report_id")
  branchId               Int      @map("branch_id")
  supervisorId           Int      @map("supervisor_id")
  shiftDate              DateTime @map("shift_date")
  chemicalsRemainingJson String?  @map("chemicals_remaining_json") // JSON {product: liters}
  towelsReceivedStart    Int      @map("towels_received_start")
  towelsCollectedEnd     Int      @map("towels_collected_end")
  storageRoomPhotosJson  String?  @map("storage_room_photos_json")
  yardPhotosJson         String?  @map("yard_photos_json")
  upsellTargetPct        Float?   @map("upsell_target_pct")
  createdAt              DateTime @default(now()) @map("created_at")

  branch     Branch   @relation(fields: [branchId], references: [id])
  supervisor Employee @relation(fields: [supervisorId], references: [id])

  @@map("shift_inventory_reports")
}

// ---------------------------------------------------------------------------
// جولة النظافة الإلزامية (كل 4 ساعات) - Phase 1
// ---------------------------------------------------------------------------
model CleanlinessCheck {
  id           Int      @id @default(autoincrement()) @map("check_id")
  branchId     Int      @map("branch_id")
  supervisorId Int      @map("supervisor_id")
  photosJson   String?  @map("photos_json")
  dueAt        DateTime @map("due_at")
  completedAt  DateTime? @map("completed_at")
  wasLocked    Boolean  @default(false) @map("was_locked")
  createdAt    DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("cleanliness_checks")
}

// ---------------------------------------------------------------------------
// جدول الصيانة الوقائية الدورية (Preventive Maintenance) - امتداد المرحلة الثالثة
// ---------------------------------------------------------------------------
model MaintenanceSchedule {
  id              Int       @id @default(autoincrement()) @map("schedule_id")
  branchId        Int       @map("branch_id")
  equipmentName   String    @map("equipment_name") // e.g. "مضخة ضغط عالي - موقف 1"
  intervalDays    Int       @map("interval_days") // كل كم يوم تلزم الصيانة
  notes           String?
  lastPerformedAt DateTime? @map("last_performed_at")
  nextDueAt       DateTime  @map("next_due_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("maintenance_schedules")
  @@index([branchId, nextDueAt])
}

// ---------------------------------------------------------------------------
// المهام والتنبيهات (Tasks & Alerts) - Phase 5
// ---------------------------------------------------------------------------
model Task {
  id             Int       @id @default(autoincrement()) @map("task_id")
  branchId       Int       @map("branch_id")
  title          String
  description    String?
  assignedToId   Int?      @map("assigned_to_id")
  createdById    Int?      @map("created_by_id")
  status         String    @default("new") // new | acknowledged | in_progress | done
  priority       String    @default("normal") // normal | urgent
  dueAt          DateTime? @map("due_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  branch     Branch    @relation(fields: [branchId], references: [id])
  assignedTo Employee? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  Employee? @relation("TaskCreator", fields: [createdById], references: [id])

  @@map("tasks")
  @@index([branchId, status])
}

// ---------------------------------------------------------------------------
// 11. الصيانة والأعطال والحوادث
// ---------------------------------------------------------------------------
model MaintenanceIncident {
  id                Int      @id @default(autoincrement()) @map("incident_id")
  branchId          Int      @map("branch_id")
  reportedById      Int?     @map("reported_by_id")
  bayId             Int?     @map("bay_id") // null = عطل عام غير مرتبط بموقف
  equipmentId       Int?     @map("equipment_id")
  breakdownType     String?  @map("breakdown_type") // نوع العطل المحدد من قائمة قصيرة
  type              String   // equipment_breakdown | customer_car_damage
  description       String
  severity          String?  // critical_stop | partial_slow
  photosJson        String?  @map("photos_json")
  compensationPaid  Float    @default(0) @map("compensation_paid")
  proposedDeduction Float    @default(0) @map("proposed_deduction")
  repairCost        Float    @default(0) @map("repair_cost")
  sparePartName     String?  @map("spare_part_name")
  sparePartSku      String?  @map("spare_part_sku")
  sparePartSupplier String?  @map("spare_part_supplier")
  sparePartCost     Float    @default(0) @map("spare_part_cost")
  laborCost         Float    @default(0) @map("labor_cost")
  warrantyMonths    Int?     @map("warranty_months")
  warrantyPhotoUrl  String?  @map("warranty_photo_url")
  invoiceUrl        String?  @map("invoice_url")
  workNotes         String?  @map("work_notes")
  decisionReason    String?  @map("decision_reason")
  decisionAt        DateTime? @map("decision_at")
  decidedById       Int?     @map("decided_by_id")
  costPending       Boolean  @default(false) @map("cost_pending") // اكتملت الصيانة ولم تُدخل التكلفة بعد
  status            String   @default("pending_approval") // pending_approval|approved|rejected|needs_amendment|returned_for_review|received|in_progress|completed
  receivedById      Int?     @map("received_by_id")
  receivedAt        DateTime? @map("received_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime @default(now()) @map("created_at")

  branch     Branch        @relation(fields: [branchId], references: [id])
  bay        Bay?          @relation(fields: [bayId], references: [id])
  equipment  BayEquipment? @relation(fields: [equipmentId], references: [id])
  receivedBy Employee?     @relation("IncidentReceiver", fields: [receivedById], references: [id])
  decidedBy  Employee?     @relation("IncidentDecider", fields: [decidedById], references: [id])

  @@map("maintenance_and_incidents")
}

// ---------------------------------------------------------------------------
// أهداف البيع (يومي / أسبوعي / شهري) لكل فرع
// ---------------------------------------------------------------------------
model SalesTarget {
  id         Int      @id @default(autoincrement()) @map("target_id")
  branchId   Int      @map("branch_id")
  serviceId  Int?     @map("service_id") // null = هدف إيراد عام للفرع
  period     String   // daily | weekly | monthly
  amount     Float    // هدف الإيراد بالريال
  targetQty  Int?     @map("target_qty") // هدف بعدد مرات البيع (اختياري)
  startDate  DateTime @map("start_date") // بداية فترة الهدف
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  branch  Branch   @relation(fields: [branchId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("sales_targets")
  @@index([branchId, period, isActive])
}

// ---------------------------------------------------------------------------
// مخزون المواد (مستودع مركزي + أرصدة الفروع + حركة التسليم والاستهلاك)
// ---------------------------------------------------------------------------
model InventoryItem {
  id            Int      @id @default(autoincrement()) @map("item_id")
  name          String
  unit          String   @default("liter") // liter | piece | kg
  warehouseQty  Float    @default(0) @map("warehouse_qty")
  minQty        Float    @default(0) @map("min_qty")
  supplier      String?
  purchasePrice Float?   @map("purchase_price")
  category      String?
  sku           String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  balances  BranchInventoryBalance[]
  movements InventoryMovement[]

  @@map("inventory_items")
}

model BranchInventoryBalance {
  id        Int   @id @default(autoincrement()) @map("balance_id")
  itemId    Int   @map("item_id")
  branchId  Int   @map("branch_id")
  quantity  Float @default(0)

  item   InventoryItem @relation(fields: [itemId], references: [id])
  branch Branch        @relation(fields: [branchId], references: [id])

  @@unique([itemId, branchId])
  @@map("branch_inventory_balances")
}

model InventoryMovement {
  id              Int      @id @default(autoincrement()) @map("movement_id")
  itemId          Int      @map("item_id")
  branchId        Int?     @map("branch_id") // null للحركات على المستودع فقط
  type            String   // warehouse_in | deliver_to_branch | consume | adjust
  quantity        Float
  recipientName   String?  @map("recipient_name")
  notes           String?
  createdById     Int?     @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  item   InventoryItem @relation(fields: [itemId], references: [id])
  branch Branch?       @relation(fields: [branchId], references: [id])

  @@map("inventory_movements")
  @@index([itemId, createdAt])
}

// سجل عمليات إداري (إضافة فوق الأساس)
model AuditLog {
  id         Int      @id @default(autoincrement()) @map("audit_id")
  actorId    Int?     @map("actor_id")
  actorName  String?  @map("actor_name")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson String?  @map("before_json")
  afterJson  String?  @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  actor Employee? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@index([entityType, createdAt])
}
